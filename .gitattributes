# Uniform LF for cross-platform development and docker images
* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Binaries (screenshots and fonts) — no eol normalization
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
